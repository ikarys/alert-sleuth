# alert-sleuth configuration. Copy to .env (git-ignored): cp .env.example .env
# Loaded at startup by aiops/config.py. Real environment variables win over this file.
# An empty value means "use the default" shown in the comment.

# --- General
# default: aiops.db
AIOPS_DB=
# 1 = demo fixtures instead of real sources (default: off)
AIOPS_DEMO=
# Collectors to run, comma list among: elasticsearch,victoriametrics,argocd,azure
# Empty = alerts only (fetch, triage, list, UI); no evidence collection.
AIOPS_SOURCES=

# --- Opsgenie (step 1: alert fetching only)
# default: https://api.opsgenie.com (EU: https://api.eu.opsgenie.com)
OPSGENIE_URL=
# API integration key with the Read access right only
OPSGENIE_API_KEY=
# default: status:open
OPSGENIE_QUERY=

# --- LLM (OpenAI-compatible endpoint)
# default: http://127.0.0.1:8000/v1 ; "off" disables the LLM
AIOPS_LLM_URL=
# default: qwen3.8-27b
AIOPS_LLM_MODEL=
AIOPS_LLM_API_KEY=

# --- LiteLLM MCP gateway (step 2: VictoriaMetrics and Elasticsearch)
# e.g. http://litellm:4000/mcp/
LITELLM_MCP_URL=
# sk-... virtual key allowed to use both MCP servers
LITELLM_API_KEY=
# mcp (default) or http
VM_MODE=
# default: query_range ; exact name from `just mcp-tools`
VM_MCP_TOOL=
# mcp (default) or http
ES_MODE=
# default: search ; exact name from `just mcp-tools`
ES_MCP_TOOL=

# --- Direct HTTP fallback (VM_MODE=http / ES_MODE=http)
VM_URL=
VM_USER=
VM_PASSWORD=
ES_URL=
ES_USER=
ES_PASSWORD=

# --- ArgoCD (later, read-only account)
# default: argocd
ARGOCD_BIN=
ARGOCD_SERVER=
ARGOCD_AUTH_TOKEN=

# --- Azure (later, Reader role; uses the current `az login` session)
# default: az
AZ_BIN=

# --- Tuning
# seconds, default: 10
AIOPS_COLLECTOR_TIMEOUT=
# default: 30
AIOPS_WINDOW_BEFORE_MIN=
# default: 10
AIOPS_WINDOW_AFTER_MIN=
# default: 2
AIOPS_CHANGES_LOOKBACK_H=
